{
  "name": "memo",
  "version": "1.6.1",
  "description": "Memo — 每日常规（可计时）+ 零碎备忘 + 完成记录的桌面备忘录（基于 flost8 改造）",
  "main": "src/main.js",
  "author": "Aryan Singh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:electron-builder": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "npm run build",
    "test": "node tests/daily.test.mjs && node tests/todo.test.mjs && node tests/area.test.mjs && node tests/parse.test.mjs && node tests/ideas.test.mjs",
    "build:mac": "electron-builder --mac --arm64 --x64"
  },
  "keywords": [
    "electron",
    "todo",
    "widget",
    "desktop",
    "productivity"
  ],
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.tianyihan.memo",
    "productName": "Memo",
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraMetadata": {
      "main": "src/main.js"
    },
    "afterPack": "build/after-pack.js",
    "mac": {
      "target": "dmg",
      "icon": "assets/icon-png.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "${productName}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yihan498",
        "repo": "memo"
      }
    ]
  }
}

{
  "name": "desktop-todo",
  "version": "2.0.0",
  "description": "每日常规 + 零碎待办 桌面提醒（基于 flost8 改造）",
  "main": "src/main.js",
  "author": "Aryan Singh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:electron-builder": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "npm run build",
    "test": "node tests/daily.test.mjs"
  },
  "keywords": [
    "electron",
    "todo",
    "widget",
    "desktop",
    "productivity"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "tailwindcss": "^4.2.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.tianyihan.desktop-todo",
    "productName": "desktop-todo",
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "compression": "store",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraMetadata": {
      "main": "src/main.js"
    }
  }
}
